{
  "name": "@eeacms/volto-eea-chatbot",
  "version": "3.0.1",
  "description": "@eeacms/volto-eea-chatbot: Volto add-on",
  "main": "src/index.js",
  "author": "European Environment Agency: IDM2 A-Team",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/eea/volto-eea-chatbot",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:eea/volto-eea-chatbot.git"
  },
  "addons": [
    "@eeacms/volto-matomo"
  ],
  "devDependencies": {
    "@babel/plugin-proposal-private-methods": "7.18.6",
    "@cypress/code-coverage": "^3.10.0",
    "@plone/scripts": "*",
    "@plone/types": "*",
    "@types/loadable__component": "5.13.10",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "8.0.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "cypress": "13.1.0",
    "cypress-fail-fast": "^5.0.1",
    "dotenv": "^16.3.2",
    "husky": "^8.0.3",
    "i": "0.3.7",
    "jsdom": "23.0.0",
    "lint-staged": "^14.0.1",
    "md5": "^2.3.0",
    "npm": "11.6.3",
    "remark-preset-wooorm": "^7.0.0",
    "typescript": "^5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@eeacms/volto-design-tokens": "*",
    "@eeacms/volto-matomo": "*",
    "@microsoft/fetch-event-source": "2.0.1",
    "@plone-collective/volto-sentry": "*",
    "@sentry/browser": "7.15.0",
    "compromise": "14.14.5",
    "dequal": "^2.0.3",
    "fast-json-patch": "3.1.1",
    "highlight.js": "11.10.0",
    "luxon": "3.5.0",
    "marked": "13.0.3",
    "node-fetch": "2.7.0",
    "qs": "^6.14.2",
    "react-markdown": "8.0.7",
    "react-textarea-autosize": "^8.5.3",
    "rehype-prism-plus": "1.6.0",
    "remark-gfm": "3.0.1",
    "uuid": "10.0.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "make lint-fix",
      "make prettier-fix"
    ],
    "src/**/*.{jsx}": [
      "make i18n"
    ],
    "theme/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "src/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "theme/**/*.overrides": [
      "make stylelint-fix"
    ],
    "src/**/*.overrides": [
      "make stylelint-fix"
    ]
  },
  "scripts": {
    "prepare": "husky install",
    "release": "release-it",
    "release-major-beta": "release-it major --preRelease=beta",
    "release-beta": "release-it --preRelease=beta",
    "bootstrap": "npm install -g ejs; npm link ejs; node bootstrap",
    "test": "vitest --config ./vitest.config.mjs run --passWithNoTests",
    "test:fix": "vitest --config ./vitest.config.mjs run --passWithNoTests --update",
    "pre-commit": "pnpm stylelint:fix && pnpm prettier:fix && pnpm lint:fix",
    "stylelint": "make stylelint",
    "stylelint:overrides": "make stylelint-overrides",
    "stylelint:fix": "make stylelint-fix",
    "prettier": "make prettier",
    "prettier:fix": "make prettier-fix",
    "lint": "make lint",
    "lint:fix": "make lint-fix",
    "i18n": "make i18n",
    "cypress:run": "make cypress-run",
    "cypress:open": "make cypress-open"
  }
}
