// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ClaimModal > handles claim with markdown formatting 1`] = `
<div
  className="claim-modal claim-green-500"
  data-testid="modal"
>
  <div
    data-testid="trigger"
  >
    <span
      className="claim claim-green-500"
    >
      something important
    </span>
  </div>
  <div
    data-testid="content"
  >
    <div
      data-testid="header"
    >
      <div
        className="claim-modal-header"
      >
        <div
          className="claim-header-top"
        >
          <div
            className="circle assistant"
          >
            <svg
              className="icon"
              dangerouslySetInnerHTML={
                {
                  "__html": "<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2M20 14h2M15 13v2M9 13v2"/>",
                }
              }
              fill="none"
              height="20"
              stroke="white"
              strokeLinecap="round"
              strokeWidth="2"
              viewBox="0 0 24 24"
              width="20"
              xmlns="http://www.w3.org/2000/svg"
            />
          </div>
          <span
            className="claim-label"
          >
            Supported by the sources
          </span>
        </div>
        <blockquote
          className="claim-quote"
        >
          “
          <span
            dangerouslySetInnerHTML={
              {
                "__html": "Bold claim with italic and <sup>1</sup>",
              }
            }
          />
          ”
        </blockquote>
      </div>
    </div>
    <div
      data-testid="modal-content"
    >
      <div
        className="claim-verification-card"
      >
        <div
          className="score-badge-section"
        >
          <div
            className="score-badge"
          >
            <span
              className="score-percentage"
            >
              Supported
            </span>
            <span
              className="score-label"
            >
              Fact check
            </span>
          </div>
          <div
            aria-hidden="true"
            className="verdict-scale"
            data-verdict="supported"
          >
            <span
              className="verdict-step"
            />
            <span
              className="verdict-step"
            />
            <span
              className="verdict-step"
            />
          </div>
        </div>
        <div
          className="rationale-section"
        >
          <h5
            className="rationale-header"
          >
            Rationale
          </h5>
          <p
            className="claim-rationale"
          >
            The claim is supported by multiple sources.
          </p>
        </div>
      </div>
      <div
        data-testid="claim-segments"
      >
        ClaimSegments
      </div>
    </div>
  </div>
</div>
`;

